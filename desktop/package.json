{
  "name": "agentcrew-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "gen:api": "node tools/api-generator/generate.mjs",
    "check:api": "node tools/api-generator/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run typecheck",
    "build": "npm run typecheck && electron-vite build"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "ajv": "8.20.0",
    "antd": "5.29.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.0",
    "vite": "^7.3.0"
  }
}
